ANTHROPIC_API_KEY=
# Bearer token for the API: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=
# Postgres: a Supabase project (session pooler URL) or a local container
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Optional
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium
CONFIDENCE_THRESHOLD=0.80
# Dev/eval only: lets eval/run_eval.py delete earlier eval uploads (real uploads and emails are kept)
ALLOW_RESET=0
# Outputs (this project's own n8n at localhost:5679; see n8n/run.sh)
N8N_OUTPUTS_WEBHOOK_URL=http://localhost:5679/webhook/brightpan-invoice-outputs
SLACK_WEBHOOK_URL=
AP_REGISTER_SHEET_URL=
FRONTEND_URL=http://localhost:3040
NOTIFY_EVAL=0
# The Gmail address n8n watches, e.g. you+brightpan-ap@gmail.com. Gmail intake stays unpublished while it is empty.
GMAIL_INTAKE_ADDRESS=
# Shared secret for the n8n outputs webhook: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
OUTPUTS_WEBHOOK_SECRET=
