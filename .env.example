ANTHROPIC_API_KEY=
# Postgres: a Supabase project (session pooler URL) or a local container
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Optional
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium
CONFIDENCE_THRESHOLD=0.80
CORS_ORIGINS=http://localhost:3040
# Dev/eval only: lets eval/run_eval.py wipe the tables before a run
ALLOW_RESET=0
